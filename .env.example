# Database Configuration (Optional)
# DATABASE_URL=mysql+pymysql://user:password@localhost/db_name

# JWT Secret Key
JWT_SECRET=RECRUITMENT_PLATFORM_SUPER_SECRET_KEY_2026_HS256

# SMTP/Email Delivery Configuration
# To send real emails via Gmail:
# 1. Set SMTP_HOST to smtp.gmail.com
# 2. Set SMTP_PORT to 587
# 3. Set SMTP_USER to your Gmail email address
# 4. Set SMTP_PASSWORD to your Gmail App Password (NOT your account password)
#    See: https://support.google.com/accounts/answer/185833
# 5. Set SMTP_SENDER to your Gmail email address
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_SENDER=your_email@gmail.com
